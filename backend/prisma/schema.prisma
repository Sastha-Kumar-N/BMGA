generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STUDENT
  RESEARCHER
  INDUSTRY
  OTHER
  CONTRIBUTOR
  MODERATOR
}

enum UserAffiliation {
  INDUSTRY
  ACADEMIC
  RESEARCH
}

enum ApprovalStatus {
  PENDING
  UNDER_REVIEW
  NEEDS_CHANGES
  APPROVED
  REJECTED
  ARCHIVED
}

enum ContactMessageStatus {
  UNREAD
  READ
}

enum AboutTeamSection {
  LEADERSHIP
  PLATFORM
  STUDENT
}

enum ToolRunStatus {
  COMPLETED
  FAILED
  PENDING
  NOT_AVAILABLE
  WARNING
  PARTIAL
}

enum EvidenceBasis {
  GENOTYPIC
  PHENOTYPIC
  COMBINED
  NOT_REPORTED
}

enum SurveillanceScope {
  NATIONAL
  GLOBAL
}

enum SubmissionFileStatus {
  UPLOADED
  PROCESSING
  INGESTED
  FAILED
}

enum GenomeReferenceKind {
  FASTA
  FAI
  GFF3
}

enum GenomeReferenceStatus {
  UPLOADED
  PUBLISHED
  FAILED
  ARCHIVED
}

enum AmrFindingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum AmrSubmissionDeclaration {
  AUTHOR
  ON_BEHALF_OF_AUTHORS
  RELEVANT_PUBLICATION_SUGGESTION
}

enum AmrImportSource {
  PUBMED
  EUROPE_PMC
  JSON_UPLOAD
}

enum AmrImportJobStatus {
  DRAFT
  PREVIEWED
  RUNNING
  COMPLETED
  FAILED
}

enum NotificationType {
  AMR_FINDING
  AMR_PUBLICATION
  AMR_IMPORT
}

enum AmrEvidenceLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  LEVEL_5
}

enum AmrPublicHealthImportance {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum AmrGeographicScope {
  LOCAL
  DISTRICT
  STATE
  MULTI_STATE
  NATIONAL
  INDIA_ASSOCIATED_INTERNATIONAL
}

enum AmrResistanceEvidence {
  PHENOTYPIC
  GENOTYPIC
  EXPERIMENTAL
  COMBINED
  NOT_REPORTED
}

enum AmrClassificationOrigin {
  REPORTED_BY_STUDY
  CURATOR_INFERRED
  DATABASE_CALCULATED
  NOT_REPORTED
}

model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  passwordHash            String                    @map("password")
  name                    String
  affiliation             UserAffiliation           @default(RESEARCH)
  role                    UserRole                  @default(STUDENT)
  authVersion             Int                       @default(0)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  profile                 UserProfile?
  organismUploads         OrganismUpload[]          @relation("UserOrganismUploads")
  reviewedOrganismUploads OrganismUpload[]          @relation("ReviewedOrganismUploads")
  submissionStatusHistory SubmissionStatusHistory[] @relation("SubmissionStatusActors")
  submissionReviewerNotes SubmissionReviewerNote[]  @relation("SubmissionReviewerNoteAuthors")
  blogPosts               BlogPost[]                @relation("UserBlogPosts")
  reviewedBlogPosts       BlogPost[]                @relation("ReviewedBlogPosts")
  adminLogs               AdminLog[]                @relation("AdminLogs")
  amrFindingsCreated      AmrFinding[]              @relation("AmrFindingCreator")
  amrFindingsReviewed     AmrFinding[]              @relation("AmrFindingReviewer")
  amrFindingsAssigned     AmrFinding[]              @relation("AmrFindingAssignedReviewer")
  amrFindingsApproved     AmrFinding[]              @relation("AmrFindingApprovedBy")
  amrFindingsPublished    AmrFinding[]              @relation("AmrFindingPublishedBy")
  amrFindingsArchived     AmrFinding[]              @relation("AmrFindingArchivedBy")
  amrFindingRevisions     AmrFindingRevision[]      @relation("AmrFindingRevisionActor")
  amrModerationNotes      AmrModerationNote[]       @relation("AmrModerationNoteAuthor")
  amrPublicationsCreated  AmrPublication[]          @relation("AmrPublicationCreator")
  amrPublicationsReviewed AmrPublication[]          @relation("AmrPublicationReviewer")
  amrPublicationsAssigned AmrPublication[]          @relation("AmrPublicationAssignedReviewer")
  amrPublicationRevisions AmrPublicationRevision[]  @relation("AmrPublicationRevisionActor")
  notifications           Notification[]
  amrImportQueries        AmrImportQuery[]          @relation("AmrImportQueryCreator")
  amrImportJobs           AmrImportJob[]            @relation("AmrImportJobCreator")
}

model UserProfile {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  title                      String?
  gender                     String?
  dateOfBirth                DateTime?
  phone                      String?
  institutionalAddress       String?
  country                    String?
  city                       String?
  designation                String?
  department                 String?
  institution                String?
  employmentStatus           String?
  highestDegree              String?
  specialization             String?
  researchInterests          String?
  researchAreas              String?
  keywords                   String?
  currentProjects            String?
  orcidId                    String?
  researcherId               String?
  scopusAuthorId             String?
  googleScholarUrl           String?
  linkedInUrl                String?
  profilePhotoPath           String?
  profilePhotoName           String?
  profilePhotoContentType    String?
  profilePhotoSizeBytes      Int?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([country])
  @@index([institution])
  @@index([orcidId])
}

model Organism {
  id             Int       @id @default(autoincrement())
  scientificName String    @unique
  displayName    String?
  taxonomyId     Int?
  domain         String?
  phylum         String?
  className      String?
  orderName      String?
  family         String?
  genus          String?
  species        String?
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  strains        Strain[]
  toolRuns       ToolRun[]

  @@index([genus])
  @@index([species])
}

model Strain {
  id                    Int               @id @default(autoincrement())
  organismId            Int
  strainName            String
  isolateName           String?
  strainCode            String?
  biosampleAccession    String?
  bioprojectAccession   String?
  assemblyAccession     String?
  sourceType            String?
  host                  String?
  country               String?
  state                 String?
  city                  String?
  collectionDate        DateTime?
  locationText          String?
  latitude              Float?
  longitude             Float?
  genomeStatus          String?
  genomeSize            Int?
  gcContent             Decimal?          @db.Decimal(5, 2)
  repoLink              String?
  metadata              Json?
  surveillanceScope     SurveillanceScope @default(GLOBAL)
  evidenceBasis         EvidenceBasis     @default(GENOTYPIC)
  submittingInstitution String?
  dataSource            String?
  dataUseLimitations    String?
  lastVerifiedAt        DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  organism         Organism              @relation(fields: [organismId], references: [id], onDelete: Cascade)
  assemblies       Assembly[]
  qcReports        QcReport[]
  annotationRuns   AnnotationRun[]
  genomicFeatures  GenomicFeature[]
  fileAssets       FileAsset[]
  amrGenes         AmrGene[]
  analysisRuns     AnalysisRun[]
  toolRuns         ToolRun[]
  genomeReferences GenomeReferenceFile[]
  amrFindings     AmrFinding[]

  @@index([organismId])
  @@index([strainName])
  @@index([assemblyAccession])
  @@index([country])
  @@index([country, collectionDate])
  @@index([organismId, collectionDate])
  @@index([sourceType])
  @@index([surveillanceScope, updatedAt])
  @@index([evidenceBasis])
  @@index([state])
  @@index([city])
}

model OrganismUpload {
  id                    String            @id @default(uuid())
  submittedById         String
  reviewedById          String?
  status                ApprovalStatus    @default(PENDING)
  reviewNote            String?
  scientificName        String
  displayName           String?
  taxonomyId            Int?
  domain                String?
  phylum                String?
  className             String?
  orderName             String?
  family                String?
  genus                 String?
  species               String?
  description           String?
  strainName            String
  isolateName           String?
  strainCode            String?
  biosampleAccession    String?
  bioprojectAccession   String?
  assemblyAccession     String?
  sourceType            String?
  host                  String?
  country               String?
  state                 String?
  city                  String?
  collectionDate        DateTime?
  locationText          String?
  latitude              Float?
  longitude             Float?
  genomeStatus          String?
  genomeSize            Int?
  gcContent             Decimal?          @db.Decimal(5, 2)
  repoLink              String?
  metadata              Json?
  surveillanceScope     SurveillanceScope @default(GLOBAL)
  evidenceBasis         EvidenceBasis     @default(GENOTYPIC)
  submittingInstitution String?
  dataSource            String?
  dataUseLimitations    String?
  lastVerifiedAt        DateTime?
  publishedOrganismId   Int?
  publishedStrainId     Int?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  reviewedAt            DateTime?

  submittedBy      User                      @relation("UserOrganismUploads", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy       User?                     @relation("ReviewedOrganismUploads", fields: [reviewedById], references: [id], onDelete: SetNull)
  statusHistory    SubmissionStatusHistory[]
  reviewerNotes    SubmissionReviewerNote[]
  files            SubmissionFile[]
  genomeReferences GenomeReferenceFile[]

  @@index([submittedById])
  @@index([reviewedById])
  @@index([status])
  @@index([surveillanceScope, status])
  @@index([country, createdAt])
  @@index([evidenceBasis])
  @@index([scientificName])
  @@index([strainName])
}

model SubmissionFile {
  id               String               @id @default(uuid())
  submissionId     String
  toolName         String
  originalFileName String
  fileType         String
  fileSizeBytes    Int
  checksumSha256   String
  storagePath      String
  toolVersion      String?
  summary          Json?
  warnings         Json?
  errors           Json?
  status           SubmissionFileStatus @default(UPLOADED)
  errorMessage     String?
  checkpointedAt   DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  ingestedAt       DateTime?

  submission OrganismUpload @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([toolName, status])
  @@index([status])
}

model GenomeReferenceFile {
  id               String                @id @default(uuid())
  submissionId     String?
  strainId         Int?
  kind             GenomeReferenceKind
  originalFileName String
  contentType      String
  fileSizeBytes    Int
  checksumSha256   String
  storagePath      String
  status           GenomeReferenceStatus @default(UPLOADED)
  isPublic         Boolean               @default(false)
  validation       Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  publishedAt      DateTime?

  submission OrganismUpload? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  strain     Strain?         @relation(fields: [strainId], references: [id], onDelete: Cascade)

  @@unique([submissionId, kind])
  @@unique([strainId, kind])
  @@index([submissionId, createdAt])
  @@index([strainId, status])
  @@index([kind, status, isPublic])
  @@index([checksumSha256])
}

model SubmissionStatusHistory {
  id                 String   @id @default(uuid())
  submissionId       String
  status             String
  actorId            String?
  note               String?
  visibleToSubmitter Boolean  @default(true)
  createdAt          DateTime @default(now())

  submission OrganismUpload @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor      User?          @relation("SubmissionStatusActors", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([actorId])
  @@index([status])
  @@index([createdAt])
}

model SubmissionReviewerNote {
  id                 String   @id @default(uuid())
  submissionId       String
  authorId           String?
  message            String
  visibleToSubmitter Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  submission OrganismUpload @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User?          @relation("SubmissionReviewerNoteAuthors", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([authorId])
  @@index([visibleToSubmitter])
  @@index([createdAt])
}

model BlogPost {
  id           String         @id @default(uuid())
  title        String
  content      String
  authorId     String
  reviewedById String?
  status       ApprovalStatus @default(PENDING)
  reviewNote   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  reviewedAt   DateTime?

  author     User  @relation("UserBlogPosts", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedBlogPosts", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([reviewedById])
  @@index([status])
  @@index([createdAt])
}

model AdminLog {
  id         String   @id @default(uuid())
  adminId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User? @relation("AdminLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}

model ContactMessage {
  id           String               @id @default(uuid())
  name         String
  email        String
  organization String?
  subject      String
  message      String
  status       ContactMessageStatus @default(UNREAD)
  adminNotes   String?
  archived     Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status])
  @@index([archived])
  @@index([createdAt])
  @@index([email])
}

model AboutTeamMember {
  id           String           @id @default(uuid())
  section      AboutTeamSection
  name         String
  title        String?
  affiliation  String?
  contribution String?
  email        String?
  course       String?
  portraitSrc  String?
  displayOrder Int              @default(0)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([section, active, displayOrder])
  @@index([active])
}

model ToolCatalogEntry {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  category    String
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, category])
}

model AmrFinding {
  id                       String                       @id @default(uuid())
  slug                     String                       @unique
  title                    String
  keyFinding               String
  scientificSummary        String
  curatorInterpretation    String?
  publicHealthSignificance String?
  limitations              String?
  futureDirections         String?
  surveillanceAction       String?
  sourceReference          String
  domainSummary            String?
  evidenceLevel            AmrEvidenceLevel
  publicHealthImportance   AmrPublicHealthImportance   @default(MODERATE)
  importanceReason         String?
  geographicScope          AmrGeographicScope          @default(STATE)
  resistanceEvidence       AmrResistanceEvidence       @default(NOT_REPORTED)
  susceptibilityMethod     String?
  interpretiveGuideline    String?
  guidelineVersion         String?
  mdrStatus                Boolean?
  xdrStatus                Boolean?
  pdrStatus                Boolean?
  classificationOrigin     AmrClassificationOrigin    @default(NOT_REPORTED)
  studyStartDate           DateTime?
  studyEndDate             DateTime?
  publicationYear          Int?
  sampleSize               Int?
  resistantSampleCount     Int?
  prevalenceNumerator      Int?
  prevalenceDenominator    Int?
  prevalencePercentage     Decimal?                    @db.Decimal(5, 2)
  studyDesign              String?
  sequencingPlatform       String?
  analysisMethod           String?
  oneHealth                Boolean                     @default(false)
  hasGenomicData           Boolean                     @default(false)
  openAccess               Boolean                     @default(false)
  curationStatus           AmrFindingStatus            @default(DRAFT)
  submissionDeclaration    AmrSubmissionDeclaration    @default(AUTHOR)
  submissionSource         String                       @default("ADMIN")
  createdById              String
  reviewedById             String?
  assignedReviewerId       String?
  approvedById             String?
  publishedById            String?
  archivedById             String?
  duplicateOfId            String?
  previousVersionId        String?
  linkedStrainId           Int?
  revisionNumber           Int                          @default(1)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  submittedAt              DateTime?
  lastReviewedAt           DateTime?
  approvedAt               DateTime?
  rejectedAt               DateTime?
  rejectionReason          String?
  changesRequestedAt       DateTime?
  changesRequestedMessage  String?
  publishedAt              DateTime?
  scheduledPublishAt       DateTime?
  archivedAt               DateTime?

  createdBy          User                    @relation("AmrFindingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy         User?                   @relation("AmrFindingReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  assignedReviewer   User?                   @relation("AmrFindingAssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  approvedBy         User?                   @relation("AmrFindingApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedBy        User?                   @relation("AmrFindingPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  archivedBy         User?                   @relation("AmrFindingArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  duplicateOf        AmrFinding?             @relation("AmrFindingDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates         AmrFinding[]            @relation("AmrFindingDuplicate")
  linkedStrain       Strain?                 @relation(fields: [linkedStrainId], references: [id], onDelete: SetNull)
  domains            AmrFindingDomain[]
  pathogens          AmrFindingPathogen[]
  genes              AmrFindingGene[]
  antimicrobials     AmrFindingAntimicrobial[]
  mechanisms         AmrFindingMechanism[]
  locations          AmrFindingLocation[]
  publications       AmrFindingPublication[]
  institutions       AmrFindingInstitution[]
  accessions         AmrFindingAccession[]
  keywords           AmrFindingKeyword[]
  mobileElements     AmrFindingMobileElement[]
  revisions          AmrFindingRevision[]
  moderationNotes    AmrModerationNote[]

  @@index([curationStatus, updatedAt])
  @@index([publicationYear])
  @@index([publicHealthImportance])
  @@index([evidenceLevel])
  @@index([createdById])
  @@index([assignedReviewerId])
  @@index([duplicateOfId])
  @@index([linkedStrainId])
  @@index([submissionSource, submittedAt])
}

model AmrControlledVocabulary {
  id        String   @id @default(uuid())
  category  String
  value     String
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains AmrFindingDomain[]

  @@unique([category, value])
  @@index([category, active, sortOrder])
}

model AmrPathogen {
  id             String   @id @default(uuid())
  scientificName String   @unique
  organismType   String?
  createdAt      DateTime @default(now())
  findings       AmrFindingPathogen[]
}

model AmrResistanceGene {
  id        String   @id @default(uuid())
  symbol    String   @unique
  variant   String?
  createdAt DateTime @default(now())
  findings  AmrFindingGene[]
}

model AmrAntimicrobialClass {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  drugs     AmrAntimicrobial[]
}

model AmrAntimicrobial {
  id        String   @id @default(uuid())
  name      String   @unique
  classId   String?
  createdAt DateTime @default(now())
  drugClass AmrAntimicrobialClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  findings  AmrFindingAntimicrobial[]
  @@index([classId])
}

model AmrResistanceMechanism {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  findings  AmrFindingMechanism[]
}

model AmrFindingDomain {
  findingId String
  termId    String
  finding   AmrFinding              @relation(fields: [findingId], references: [id], onDelete: Cascade)
  term      AmrControlledVocabulary @relation(fields: [termId], references: [id], onDelete: Restrict)
  @@id([findingId, termId])
  @@index([termId])
}

model AmrFindingPathogen {
  findingId  String
  pathogenId String
  strain     String?
  lineage    String?
  sequenceType String?
  serotype   String?
  finding    AmrFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  pathogen   AmrPathogen @relation(fields: [pathogenId], references: [id], onDelete: Restrict)
  @@id([findingId, pathogenId])
  @@index([pathogenId])
}

model AmrFindingGene {
  findingId String
  geneId    String
  finding   AmrFinding       @relation(fields: [findingId], references: [id], onDelete: Cascade)
  gene      AmrResistanceGene @relation(fields: [geneId], references: [id], onDelete: Restrict)
  @@id([findingId, geneId])
  @@index([geneId])
}

model AmrFindingAntimicrobial {
  findingId       String
  antimicrobialId String
  phenotype       String?
  finding         AmrFinding        @relation(fields: [findingId], references: [id], onDelete: Cascade)
  antimicrobial   AmrAntimicrobial  @relation(fields: [antimicrobialId], references: [id], onDelete: Restrict)
  @@id([findingId, antimicrobialId])
  @@index([antimicrobialId])
}

model AmrFindingMechanism {
  findingId   String
  mechanismId String
  finding     AmrFinding             @relation(fields: [findingId], references: [id], onDelete: Cascade)
  mechanism   AmrResistanceMechanism @relation(fields: [mechanismId], references: [id], onDelete: Restrict)
  @@id([findingId, mechanismId])
  @@index([mechanismId])
}

model AmrFindingLocation {
  id         String   @id @default(uuid())
  findingId  String
  country    String   @default("India")
  state      String?
  district   String?
  city       String?
  locality   String?
  facility   String?
  latitude   Float?
  longitude  Float?
  finding    AmrFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  @@index([findingId])
  @@index([state])
  @@index([district])
}

model AmrPublication {
  id            String   @id @default(uuid())
  slug          String?  @unique
  title         String
  authors       String?
  userRoleInPublication String?
  journal       String?
  publicationYear Int?
  doi           String?  @unique
  pubmedId      String?  @unique
  pmcId         String?  @unique
  europePmcId   String?  @unique
  externalUrl   String?
  citationText  String?
  openAccess    Boolean  @default(false)
  submissionDeclaration AmrSubmissionDeclaration @default(AUTHOR)
  submissionSource String @default("ADMIN")
  curationStatus AmrFindingStatus @default(DRAFT)
  createdById String?
  reviewedById String?
  assignedReviewerId String?
  duplicateOfId String?
  previousVersionId String?
  revisionNumber Int @default(1)
  submittedAt DateTime?
  reviewedAt DateTime?
  approvedAt DateTime?
  publishedAt DateTime?
  scheduledPublishAt DateTime?
  archivedAt DateTime?
  rejectionReason String?
  changesRequestedMessage String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  findings      AmrFindingPublication[]
  createdBy User? @relation("AmrPublicationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("AmrPublicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  assignedReviewer User? @relation("AmrPublicationAssignedReviewer", fields: [assignedReviewerId], references: [id], onDelete: SetNull)
  duplicateOf AmrPublication? @relation("AmrPublicationDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates AmrPublication[] @relation("AmrPublicationDuplicate")
  moderationNotes AmrModerationNote[]
  revisions AmrPublicationRevision[]
  @@index([publicationYear])
  @@index([curationStatus, updatedAt])
  @@index([createdById])
  @@index([assignedReviewerId])
  @@index([duplicateOfId])
}

model AmrFindingPublication {
  findingId     String
  publicationId String
  finding       AmrFinding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  publication   AmrPublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  @@id([findingId, publicationId])
  @@index([publicationId])
}

model AmrFindingInstitution {
  id        String   @id @default(uuid())
  findingId String
  name      String
  role      String?
  finding   AmrFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  @@index([findingId])
}

model AmrFindingAccession {
  id        String   @id @default(uuid())
  findingId String
  database  String
  accession String
  url       String?
  finding   AmrFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  @@unique([findingId, database, accession])
  @@index([accession])
}

model AmrFindingKeyword {
  id        String   @id @default(uuid())
  findingId String
  value     String
  finding   AmrFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  @@unique([findingId, value])
  @@index([value])
}

model AmrFindingMobileElement {
  id        String   @id @default(uuid())
  findingId String
  type      String
  name      String
  finding   AmrFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  @@unique([findingId, type, name])
  @@index([type, name])
}

model AmrFindingRevision {
  id        String   @id @default(uuid())
  findingId String
  actorId   String?
  action    String
  note      String?
  visibleToSubmitter Boolean @default(false)
  snapshot  Json?
  createdAt DateTime @default(now())
  finding   AmrFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  actor     User?      @relation("AmrFindingRevisionActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([findingId, createdAt])
  @@index([actorId])
}

model AmrPublicationRevision {
  id            String   @id @default(uuid())
  publicationId String
  actorId       String?
  action        String
  note          String?
  visibleToSubmitter Boolean @default(false)
  snapshot      Json?
  createdAt     DateTime @default(now())
  publication   AmrPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  actor         User? @relation("AmrPublicationRevisionActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([publicationId, createdAt])
  @@index([actorId])
}

model AmrModerationNote {
  id                  String   @id @default(uuid())
  findingId           String?
  publicationId       String?
  authorId            String
  message             String
  visibleToSubmitter  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  finding             AmrFinding? @relation(fields: [findingId], references: [id], onDelete: Cascade)
  publication         AmrPublication? @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  author              User @relation("AmrModerationNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  @@index([findingId, createdAt])
  @@index([publicationId, createdAt])
  @@index([authorId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model AmrImportQuery {
  id        String          @id @default(uuid())
  name      String
  source    AmrImportSource
  query     String
  active    Boolean         @default(true)
  createdById String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  createdBy User            @relation("AmrImportQueryCreator", fields: [createdById], references: [id], onDelete: Cascade)
  jobs      AmrImportJob[]
  @@index([source, active])
  @@index([createdById])
}

model AmrImportJob {
  id          String             @id @default(uuid())
  queryId     String?
  source      AmrImportSource
  request     Json
  preview     Json?
  result      Json?
  status      AmrImportJobStatus @default(DRAFT)
  attempt     Int                @default(0)
  errorMessage String?
  createdById String
  createdAt   DateTime           @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  query       AmrImportQuery?    @relation(fields: [queryId], references: [id], onDelete: SetNull)
  createdBy   User               @relation("AmrImportJobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  @@index([source, status, createdAt])
  @@index([queryId])
  @@index([createdById])
}

model Assembly {
  id              Int      @id @default(autoincrement())
  strainId        Int
  assemblyName    String?
  assemblyVersion String?
  assembler       String?
  assemblyLevel   String?
  contigCount     Int?
  scaffoldCount   Int?
  n50             Int?
  l50             Int?
  longestContig   Int?
  totalLength     Int?
  gapCount        Int?
  metadata        Json?
  createdAt       DateTime @default(now())

  strain     Strain      @relation(fields: [strainId], references: [id], onDelete: Cascade)
  fileAssets FileAsset[]

  @@index([strainId])
}

model QcReport {
  id                             Int      @id @default(autoincrement())
  strainId                       Int
  qcTool                         String
  reportType                     String?
  perBaseQualityStatus           String?
  perSequenceQualityStatus       String?
  adapterContentStatus           String?
  duplicationStatus              String?
  overrepresentedSequencesStatus String?
  percentGc                      Decimal? @db.Decimal(5, 2)
  totalSequences                 Int?
  summary                        Json?
  createdAt                      DateTime @default(now())

  strain Strain @relation(fields: [strainId], references: [id], onDelete: Cascade)

  @@index([strainId])
  @@index([qcTool])
}

model AnnotationRun {
  id              Int      @id @default(autoincrement())
  strainId        Int
  toolName        String
  toolVersion     String?
  cdsCount        Int?
  trnaCount       Int?
  rrnaCount       Int?
  ncrnaCount      Int?
  pseudogeneCount Int?
  metadata        Json?
  createdAt       DateTime @default(now())

  strain          Strain           @relation(fields: [strainId], references: [id], onDelete: Cascade)
  genomicFeatures GenomicFeature[]
  fileAssets      FileAsset[]

  @@index([strainId])
  @@index([toolName])
}

model GenomicFeature {
  id              Int      @id @default(autoincrement())
  strainId        Int
  annotationRunId Int?
  seqid           String?
  locusTag        String?
  geneName        String?
  featureType     String
  startPos        Int
  endPos          Int
  strand          String?
  product         String?
  proteinId       String?
  geneBiotype     String?
  attributes      Json?
  createdAt       DateTime @default(now())

  strain        Strain         @relation(fields: [strainId], references: [id], onDelete: Cascade)
  annotationRun AnnotationRun? @relation(fields: [annotationRunId], references: [id], onDelete: SetNull)

  @@index([strainId])
  @@index([geneName])
  @@index([locusTag])
  @@index([featureType])
}

model FileAsset {
  id              Int      @id @default(autoincrement())
  strainId        Int?
  assemblyId      Int?
  annotationRunId Int?
  analysisRunId   Int?
  fileType        String
  fileName        String
  bucketName      String
  objectKey       String
  contentType     String?
  fileSizeBytes   Int?
  checksumSha256  String?
  isPublic        Boolean  @default(false)
  metadata        Json?
  createdAt       DateTime @default(now())

  strain        Strain?        @relation(fields: [strainId], references: [id], onDelete: Cascade)
  assembly      Assembly?      @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  annotationRun AnnotationRun? @relation(fields: [annotationRunId], references: [id], onDelete: Cascade)
  analysisRun   AnalysisRun?   @relation("AnalysisRunOutputFiles", fields: [analysisRunId], references: [id], onDelete: Cascade)

  inputToRuns AnalysisRun[] @relation("AnalysisRunInputFile")
  toolResults ToolResult[]

  @@index([fileType])
}

model AnalysisRun {
  id         Int      @id @default(autoincrement())
  strainId   Int
  sampleName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  strain      Strain       @relation(fields: [strainId], references: [id], onDelete: Cascade)
  inputFileId Int?
  inputFile   FileAsset?   @relation("AnalysisRunInputFile", fields: [inputFileId], references: [id], onDelete: SetNull)
  outputFiles FileAsset[]  @relation("AnalysisRunOutputFiles")
  toolResults ToolResult[]

  fastqc     FastqcResult?
  fastp      FastpResult?
  multiqc    MultiqcResult?
  spades     SpadesResult?
  quast      QuastResult?
  busco      BuscoResult?
  checkm     CheckmResult?
  prokka     ProkkaResult?
  diamond    DiamondResult?
  kofamkoala KofamkoalaResult?
  abricate   AbricateResult?
  mlst       MlstResult?
  islandPath IslandPathResult?
  trnascan   TrnascanSeResult?
  hmmer      HmmerResult?
  minced     MincedResult?
  jellyfish  JellyfishResult?
  trf        TrfResult?
  barrnap    BarrnapResult?
  antismash  AntismashResult?

  @@index([strainId])
}

model FastqcResult {
  id                   Int     @id @default(autoincrement())
  analysisRunId        Int     @unique
  totalReads           Int?
  gcContent            Float?
  q30Rate              Float?
  duplicationRate      Float?
  sequenceLengthMinBp  Int?
  sequenceLengthMaxBp  Int?
  adapterContentStatus String?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model FastpResult {
  id                   Int    @id @default(autoincrement())
  analysisRunId        Int    @unique
  readsBeforeFiltering Int?
  readsAfterFiltering  Int?
  q20Rate              Float?
  q30Rate              Float?
  duplicationRate      Float?
  insertSizePeakBp     Int?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model MultiqcResult {
  id                  Int    @id @default(autoincrement())
  analysisRunId       Int    @unique
  samplesAnalysed     Int?
  avgSequenceLengthBp Int?
  gcContent           Float?
  duplicatesR1        Float?
  duplicatesR2        Float?
  failedModules       Int?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model SpadesResult {
  id              Int    @id @default(autoincrement())
  analysisRunId   Int    @unique
  totalContigs    Int?
  largestContigKb Float?
  n50Kb           Float?
  totalLengthMb   Float?
  coverageX       Float?
  peakMemoryGb    Float?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model QuastResult {
  id                 Int    @id @default(autoincrement())
  analysisRunId      Int    @unique
  n50Kb              Float?
  l50                Int?
  genomeFraction     Float?
  mismatchesPer100Kb Float?
  largestContigKb    Float?
  duplicationRatio   Float?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model BuscoResult {
  id                Int     @id @default(autoincrement())
  analysisRunId     Int     @unique
  completePercent   Float?
  singleCopyPercent Float?
  duplicatedPercent Float?
  fragmentedPercent Float?
  missingPercent    Float?
  lineage           String?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model CheckmResult {
  id                  Int     @id @default(autoincrement())
  analysisRunId       Int     @unique
  completeness        Float?
  contamination       Float?
  strainHeterogeneity Float?
  qualityScore        Float?
  markerGenes         Int?
  lineage             String?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model ProkkaResult {
  id                   Int    @id @default(autoincrement())
  analysisRunId        Int    @unique
  cdsCount             Int?
  rrnaGenes            Int?
  trnaGenes            Int?
  hypotheticalProteins Int?
  codingDensity        Float?
  pseudogenes          Int?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model DiamondResult {
  id               Int     @id @default(autoincrement())
  analysisRunId    Int     @unique
  queriesAligned   Int?
  percentAligned   Float?
  databaseName     String?
  avgIdentity      Float?
  evalueCutoff     String?
  unalignedQueries Int?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model KofamkoalaResult {
  id             Int     @id @default(autoincrement())
  analysisRunId  Int     @unique
  genesAnnotated Int?
  keggPathways   Int?
  koCoverage     Float?
  avgHmmScore    Float?
  dbRelease      String?
  topPathway     String?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model AbricateResult {
  id             Int     @id @default(autoincrement())
  analysisRunId  Int     @unique
  genesFound     Int?
  minCoverage    Float?
  minIdentity    Float?
  topHit         String?
  virulenceGenes Int?
  plasmidGenes   Int?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model MlstResult {
  id              Int      @id @default(autoincrement())
  analysisRunId   Int      @unique
  scheme          String?
  sequenceType    String?
  allelesMatched  String?
  confidence      Float?
  clonalComplex   String?
  pandemicLineage Boolean?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model IslandPathResult {
  id              Int      @id @default(autoincrement())
  analysisRunId   Int      @unique
  gisDetected     Int?
  totalGiLengthKb Float?
  avgGiLengthKb   Float?
  giLinkedGenes   Int?
  amrIsland       Boolean?
  amrIslandName   String?
  amrGene         String?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model TrnascanSeResult {
  id             Int     @id @default(autoincrement())
  analysisRunId  Int     @unique
  trnasFound     Int?
  aminoAcidTypes Int?
  pseudoTrnas    Int?
  anticodons     Int?
  hotspots       Int?
  modelType      String?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model HmmerResult {
  id            Int     @id @default(autoincrement())
  analysisRunId Int     @unique
  domainsFound  Int?
  pfamHits      Int?
  tigrfamHits   Int?
  avgEvalue     String?
  databases     String?
  novelDomains  Int?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model MincedResult {
  id              Int     @id @default(autoincrement())
  analysisRunId   Int     @unique
  crisprArrays    Int?
  totalSpacers    Int?
  repeatLengthBp  Int?
  spacerLengthBp  Int?
  phageMatches    Int?
  arraysOnContigs String?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model JellyfishResult {
  id                   Int    @id @default(autoincrement())
  analysisRunId        Int    @unique
  kmerSize             Int?
  distinctKmersMillion Float?
  totalKmersBillion    Float?
  peakFrequencyX       Float?
  genomeSizeMb         Float?
  repeatContent        Float?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model TrfResult {
  id                 Int    @id @default(autoincrement())
  analysisRunId      Int    @unique
  tandemRepeats      Int?
  totalLengthKb      Float?
  genomeFraction     Float?
  avgPeriodSizeBp    Int?
  maxCopy            Float?
  phaseVariationLoci Int?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model BarrnapResult {
  id            Int     @id @default(autoincrement())
  analysisRunId Int     @unique
  rrna16S       Int?
  rrna23S       Int?
  rrna5S        Int?
  totalRrna     Int?
  evalueCutoff  String?
  taxonomy      String?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model AntismashResult {
  id            Int     @id @default(autoincrement())
  analysisRunId Int     @unique
  bgcRegions    Int?
  bgcTypes      String?
  mibigMatches  Int?
  novelBgcs     Int?
  mibigHit      String?
  databaseName  String?

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
}

model AmrGene {
  id                  Int           @id @default(autoincrement())
  strainId            Int
  toolRunId           Int?
  geneSymbol          String
  drugClass           String?
  drugName            String?
  resistanceMechanism String?
  identity            Float?
  coverage            Float?
  databaseName        String?
  phenotype           String?
  evidenceBasis       EvidenceBasis @default(GENOTYPIC)
  createdAt           DateTime      @default(now())

  strain  Strain   @relation(fields: [strainId], references: [id], onDelete: Cascade)
  toolRun ToolRun? @relation(fields: [toolRunId], references: [id], onDelete: SetNull)

  @@index([strainId])
  @@index([toolRunId])
  @@index([geneSymbol])
  @@index([drugClass])
  @@index([evidenceBasis])
  @@index([createdAt])
}

model ToolResult {
  id            Int      @id @default(autoincrement())
  analysisRunId Int
  resultType    String
  title         String?
  description   String?
  format        String?
  fileAssetId   Int?
  jsonData      Json?
  textData      String?
  createdAt     DateTime @default(now())

  analysisRun AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)
  fileAsset   FileAsset?  @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)

  @@index([analysisRunId])
  @@index([resultType])
}

model ToolRun {
  id         Int           @id @default(autoincrement())
  organismId Int
  strainId   Int?
  toolName   String
  status     ToolRunStatus @default(PENDING)
  version    String?
  startedAt  DateTime?
  finishedAt DateTime?
  summary    Json?
  warnings   Json?
  errors     Json?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  organism Organism          @relation(fields: [organismId], references: [id], onDelete: Cascade)
  strain   Strain?           @relation(fields: [strainId], references: [id], onDelete: Cascade)
  tables   ToolResultTable[]
  files    ToolOutputFile[]
  amrGenes AmrGene[]

  @@index([organismId])
  @@index([strainId])
  @@index([toolName])
  @@index([status])
}

model ToolResultTable {
  id        Int      @id @default(autoincrement())
  toolRunId Int
  tableName String
  columns   Json
  rows      Json
  createdAt DateTime @default(now())

  toolRun ToolRun @relation(fields: [toolRunId], references: [id], onDelete: Cascade)

  @@index([toolRunId])
}

model ToolOutputFile {
  id          Int      @id @default(autoincrement())
  toolRunId   Int
  fileName    String
  fileType    String?
  filePath    String
  description String?
  createdAt   DateTime @default(now())

  toolRun ToolRun @relation(fields: [toolRunId], references: [id], onDelete: Cascade)

  @@index([toolRunId])
  @@index([fileType])
}
